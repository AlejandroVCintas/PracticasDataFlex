38351>>>>>>>    Procedure SetActionButtons
38354>>>>>>>        tWebNavigateData NavigateData
38354>>>>>>>        tWebNavigateData NavigateData
38354>>>>>>>        Boolean bHasRecord
38354>>>>>>>        Handle hoDD
38354>>>>>>>
38354>>>>>>>        Get Server to hoDD
38355>>>>>>>        Get GetNavigateData to NavigateData
38356>>>>>>>        Get HasRecord of hoDD to bHasRecord
38357>>>>>>>
38357>>>>>>>        // let's hide all buttons and then Show the ones we want
38357>>>>>>>        WebSet pbRender of oEditBtn to False
38358>>>>>>>        WebSet pbRender of oSaveBtn to False
38359>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38360>>>>>>>        WebSet pbRender of oDeleteBtn to False
38361>>>>>>>
38361>>>>>>>        If (NavigateData.bReadOnly) Begin
38363>>>>>>>            WebSet pbRender of oEditBtn to True
38364>>>>>>>        End
38364>>>>>>>>
38364>>>>>>>        Else Begin
38365>>>>>>>            WebSet pbRender of oSaveBtn to True
38366>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38367>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38368>>>>>>>        End
38368>>>>>>>>
38368>>>>>>>    End_Procedure
38369>>>>>>>
